 "isLinked": false}, "content_width": {"unit": "px", "size": 1140, "sizes": []}, "gap": "extended", "background_background": "classic", "background_color": "#F5F5F5"}, "elements": [{"id": "6330a4d", "elType": "column", "settings": {"_column_size": 50, "_inline_size": null}, "elements": [{"id": "76883f0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Para que serve a escora metálica", "header_size": "h2", "title_color": "#1C1C1C", "align": "left", "typography_typography": "custom", "typography_font_family": "Sora", "typography_font_size": {"unit": "px", "size": 30, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 24, "sizes": []}, "typography_font_weight": "700", "typography_line_height": {"unit": "em", "size": 1.2, "sizes": []}}, "elements": []}, {"id": "2e624c8", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>A <strong>escora metálica</strong> sustenta lajes, vigas e formas enquanto o concreto não atinge a resistência necessária. Por ser regulável, ela se ajusta à altura do pé-direito e é mais rápida de montar e mais resistente que o escoramento de madeira.</p><p>Com o <strong>aluguel de escoras</strong>, você usa a quantidade exata para cada concretagem e devolve ao final, sem estoque parado. Para a mesma obra, alugamos também <a href=\"https://andaimaq.com.br/aluguel-de-betoneira/\">betoneira</a> e <a href=\"https://andaimaq.com.br/locacao-de-andaime/\">andaime</a>.</p>", "text_color": "#4A4A4A", "align": "left", "typography_typography": "custom", "typography_font_family": "Roboto", "typography_font_size": {"unit": "px", "size": 17, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.6, "sizes": []}}, "elements": []}], "isInner": false}, {"id": "67fb389", "elType": "column", "settings": {"_column_size": 50, "_inline_size": null}, "elements": [{"id": "06b4e62", "elType": "widget", "widgetType": "heading", "settings": {"title": "Quanto custa alugar escora metálica?", "header_size": "